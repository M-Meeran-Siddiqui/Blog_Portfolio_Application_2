<%= form_for(@portfolio) do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="form-group">
        <%= f.label :title %>
        <%= f.text_field :title, class:'form-control' %>
      </div>

      <div class="form-group">
        <%= f.label :subtitle %>
        <%= f.text_field :subtitle, class:'form-control' %>
      </div>

      <div class="form-group">
        <label class="btn btn-primary">
          Upload main image <%= f.file_field :main_image, style: 'display:none;' %>
        </label>
      </div>

      <div class="form-group">
        <label class="btn btn-primary">
          Upload thumb image <%= f.file_field :thumb_image, style: 'display:none;' %>
        </label>
      </div>
    </div>

    <div class="col-md-6">
      <div class="form-group">
        <%= f.label :body %>
        <%= f.text_area :body, class:'form-control' %>
      </div>
    </div>
  </div>

  <hr>

  <div class="col-md-12">
      <h2>Technologies Used:</h2> 
      <%= f.fields_for :technologies do |technology_form|%>
        <%= technology_form.label :name %>  
        <%= technology_form.text_field :name, class:'form-control'%>
      <% end %>
      </div>
    </div>

    <div class="form-group text-center  mt-4">
     <%= f.submit "Save Portfolio Item", class: "btn btn-primary w-50" %>
    </div>

  </div>
  
<% end %>
