<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
  <title><%= @page_title || "My Site" %></title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="keywords" content="<%= @seo_keywords %>" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  <%= javascript_importmap_tags %>
  
  <!-- Bootstrap 4.6.2 CSS -->

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
    integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N"
    crossorigin="anonymous"
  >

</head>
<body class="d-flex h-100 text-center text-white bg-dark">

  
  <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
    <header class="mb-auto">
      <div class="d-flex justify-content-between align-items-center">
        <%# below is the background image %>
        <%# <div id="background"> </div> %>
        
        <%# below is the background video %>
        
        <%= video_tag(
          "background.mp4",
          id: 'background',
          autoplay: true,
          loop: true,
          muted: true,
          preload: "auto",
          poster: 'image.png',
          height: "70%",
          width: "70%",
        ) %>

        <%# <div class="video-overlay"></div> %>

        <h3 class="float-md-start mb-0 text-white">MEERAN</h3>
        <%= render "shared/nav", location: 'top' %>
      </div>
    </header>

    <main class="px-3">
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>
      <%= yield %>  <%# Page-specific content will be injected here %>
    </main>

    <footer class="mt-auto text-white-50">
      <p class="app-footer"><%= @copyright %></p>
    </footer>
  </div>

  <!-- Bootstrap 4.6.2 JS, Popper, and jQuery -->
 
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"
    crossorigin="anonymous"
  ></script>


  <%= javascript_include_tag "html5sortable" %>
  <%= javascript_include_tag "portfolio" %>
  
  
</body>
</html>
